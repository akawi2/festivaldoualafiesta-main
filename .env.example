# Copier en .env (jamais commité) pour le dev local, ou renseigner ces
# mêmes valeurs comme variables d'environnement dans l'outil "Deploy Web
# App" de l'hébergeur (Hostinger). Ce sont des build args Vite — elles sont
# intégrées dans le bundle au moment du build (`npm run build`, ou le
# "postinstall" automatique sur l'hébergeur), donc un rebuild est
# nécessaire après tout changement, un redémarrage seul ne suffit pas.

# URL du projet Supabase cloud (Project Settings → API → Project URL).
VITE_SUPABASE_URL=https://yvufxwxwlzywptcxzlki.supabase.co

# Clé anon/publishable du même projet (Project Settings → API) — clé
# publique, jamais la service_role key.
VITE_SUPABASE_PUBLISHABLE_KEY=
