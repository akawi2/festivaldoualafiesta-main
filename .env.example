# Copier en .env (jamais commité) une fois le service "supabase-selfhost"
# déployé et démarré. Ces valeurs sont lues par docker-compose.yml et passées
# au Dockerfile comme build args — Vite les intègre dans le bundle au build,
# donc il faut reconstruire l'image (`docker compose build`) après tout
# changement ici, un redémarrage seul ne suffit pas.

# URL publique du Supabase self-hosted (le domaine derrière Traefik, voir
# SUPABASE_PUBLIC_HOSTNAME dans supabase-selfhost/.env) — pas 127.0.0.1.
VITE_SUPABASE_URL=https://supabase.festivaldoualafiesta.cm

# La valeur ANON_KEY de supabase-selfhost/.env (clé publique, pas SERVICE_ROLE_KEY).
VITE_SUPABASE_PUBLISHABLE_KEY=

# Domaine public de CETTE app (utilisé par le label Traefik dans
# docker-compose.yml — pas un build arg, un redéploiement suffit après
# changement, pas besoin de rebuild). Défaut festivaldoualafiesta.cm si absent.
APP_PUBLIC_HOSTNAME=festivaldoualafiesta.cm
